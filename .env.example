NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional for local development. Defaults to http://<APP_HOST>:$PORT, or
# http://localhost:3000 when APP_HOST and PORT are not set. Set APP_URL
# explicitly in deployments.
# APP_HOST=192.168.1.25
# APP_URL=http://localhost:3000

# Restricted moneymap_app login, never postgres/service_role
DATABASE_URL=

# [EXCLUDE FROM PROD] Admin connection used only by migration/restore tooling
DATABASE_ADMIN_URL=

# JSON map of key version to base64-encoded 32-byte AES key
MONEYMAP_MASTER_KEYS=
MONEYMAP_ACTIVE_KEY_VERSION=1

# [EXCLUDE FROM PROD] Optional, isolated integration test database only
TEST_DATABASE_URL=

# [EXCLUDE FROM PROD] Used by the Supabase CLI to run the local development environment
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
