NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://localhost:3000

# Restricted moneymap_app login, never postgres/service_role
DATABASE_URL=
# Admin connection used only by migration/restore tooling
DATABASE_ADMIN_URL=

# JSON map of key version to base64-encoded 32-byte AES key
MONEYMAP_MASTER_KEYS=
MONEYMAP_ACTIVE_KEY_VERSION=1

# Configure the OAuth access-token hook to issue this audience
OAUTH_AUDIENCE=http://localhost:3000
# Optional, isolated integration test database only
TEST_DATABASE_URL=

# Used by the Supabase CLI to run the local development environment
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
